<mujoco model="mapping_drone">
    <compiler angle="degree" coordinate="local"/>
    <option gravity="0 0 -9.81"/>

    <!--Defining Colors-->
    <asset>
        <material name="black" rgba="0.1 0.1 0.1 1"/>
        <material name="blue" rgba="0.2 0.2 0.8 1"/>
        <material name="red" rgba="0.8 0.1 0.1 1"/>
        <material name="green" rgba="0.1 0.8 0.1 1"/>
        <material name="wall" rgba="0.7 0.3 0.3 1"/>
    </asset>

    <worldbody>
        <!-- Ground Plane -->
        <geom name="floor" type="plane" size="20 20 0.1" rgba="0.8 0.8 0.8 1" friction="1.0 0.1 0.1"/>
        <light directional="true" diffuse="0.8 0.8 0.8" pos="0 0 5" dir="0 0 -1"/>

        <!-- Wall at X = 3m for Single-point sensor object detection -->
        <geom name="obstacle_wall" type="plane" pos="3.0 0 0" zaxis="-1 0 0" size="10 10 0.1" material="wall"/>

        <!-- Drone Body -->
        <body name="drone" pos="0 0 0.12">
	     
            <!--Adding mobility-->
            <freejoint name="root"/>

            <!-- Center body, 28cm diameter, 11cm height, 1.966 kg weight -->
            <geom name="fuselage" type="cylinder" size="0.14 0.055" mass="1.966" material="blue"/>

            <!-- Landing legs (used cylinders rather than modelling the current Sky claw legs), total 0.04 kg, 3cm off ground-->
            <geom name="leg_fr" type="cylinder" pos=" 0.10  0.10 -0.07" size="0.008 0.02" mass="0.01" material="black"/>
            <geom name="leg_fl" type="cylinder" pos="-0.10  0.10 -0.07" size="0.008 0.02" mass="0.01" material="black"/>
            <geom name="leg_bl" type="cylinder" pos="-0.10 -0.10 -0.07" size="0.008 0.02" mass="0.01" material="black"/>
            <geom name="leg_br" type="cylinder" pos=" 0.10 -0.10 -0.07" size="0.008 0.02" mass="0.01" material="black"/>

            <!-- Propeller Arms, total 0.32 kg -->
            <geom name="arm_fr" type="cylinder" fromto="0 0 0   0.297  0.297 0" size="0.015" mass="0.08" material="black"/>
            <geom name="arm_fl" type="cylinder" fromto="0 0 0  -0.297  0.297 0" size="0.015" mass="0.08" material="black"/>
            <geom name="arm_bl" type="cylinder" fromto="0 0 0  -0.297 -0.297 0" size="0.015" mass="0.08" material="black"/>
            <geom name="arm_br" type="cylinder" fromto="0 0 0   0.297 -0.297 0" size="0.015" mass="0.08" material="black"/>

            <!-- Motors, total 0.32kg -->
            <geom name="motor_fr" type="cylinder" pos=" 0.297  0.297 0.02" size="0.035 0.01" mass="0.08" material="red"/>
            <geom name="motor_fl" type="cylinder" pos="-0.297  0.297 0.02" size="0.035 0.01" mass="0.08" material="green"/>
            <geom name="motor_bl" type="cylinder" pos="-0.297 -0.297 0.02" size="0.035 0.01" mass="0.08" material="green"/>
            <geom name="motor_br" type="cylinder" pos=" 0.297 -0.297 0.02" size="0.035 0.01" mass="0.08" material="green"/>

            <!-- Thrust Sites -->
            <site name="site_fr" pos=" 0.297  0.297 0.02" size="0.01" rgba="0 0 0 0"/>
            <site name="site_fl" pos="-0.297  0.297 0.02" size="0.01" rgba="0 0 0 0"/>
            <site name="site_bl" pos="-0.297 -0.297 0.02" size="0.01" rgba="0 0 0 0"/>
            <site name="site_br" pos=" 0.297 -0.297 0.02" size="0.01" rgba="0 0 0 0"/>

            <!-- Sensor Sites -->
            <site name="gps_site" pos="0 0 0.055" size="0.01" rgba="1 1 1 1"/>
            <site name="single_point_site" pos="0.14 0 0" zaxis="1 0 0" size="0.01" rgba="1 1 0 1"/>
            <site name="lidar_site" pos="0 0 -0.055" zaxis="0 0 -1" size="0.01" rgba="1 0 0 1"/>

            <!-- Cameras -->
            <!-- RGB Camera: Forward-looking -->
            <camera name="rgb_camera" pos="0.14 0 0" zaxis="1 0 0" fovy="60"/>
            
            <!-- Thermal Camera: Downward-looking -->
            <camera name="flir_camera" pos="0 0.04 -0.055" zaxis="0 0 -1" fovy="60"/>
            
            <!-- LiDAR Camera: Downward-looking -->
            <camera name="lidar_downward" pos="0 -0.04 -0.055" zaxis="0 0 -1" fovy="90"/>
        </body>
    </worldbody>

    <!-- Thrusters, 0-20N, all force along z axis, torque from rotors should cancel out  -->
    <actuator>
        <motor name="act_fr" site="site_fr" gear="0 0 1 0 0 -0.02" ctrlrange="0 20"/>
        <motor name="act_fl" site="site_fl" gear="0 0 1 0 0  0.02" ctrlrange="0 20"/>
        <motor name="act_bl" site="site_bl" gear="0 0 1 0 0 -0.02" ctrlrange="0 20"/>
        <motor name="act_br" site="site_br" gear="0 0 1 0 0  0.02" ctrlrange="0 20"/>
    </actuator>

    <!-- Sensors -->
    <sensor>
        <framepos name="gps_pos" objtype="site" objname="gps_site"/>
        <rangefinder name="single_point_dist" site="single_point_site" cutoff="10"/>
        <rangefinder name="lidar_dist" site="lidar_site" cutoff="10"/>
    </sensor>
</mujoco>